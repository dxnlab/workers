{
  "name": "@dxnlab/workers",
  "description": "Just wanted to run workers",
  "license": "MIT",
  "keywords": [
    "worker"
  ],
  "version": "0.1.9",
  "type": "module",
  "exports": {
    ".": {
      "main": "./dist/index.cjs",
      "browser": "./dist/index.js"
    },
    "./worker": {
      "main": "./dist/worker.cjs",
      "browser": "./dist/worker.js",
      "types": "./dist/worker.types.d.ts"
    },
    "./shared": {
      "main": "./dist/shared.cjs",
      "browser": "./dist/shared.js"
    },
    "./service": {
      "main": "./dist/service.cjs",
      "browser": "./dist/service.js"
    }
  },
  "author": "yg.song <yg.song@dxnlab.com>",
  "scripts": {
    "dev": "vite -c ./vite.preview.ts",
    "build": "tsc && vite build",
    "test": "wdio run ./wdio.conf.ts ",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "vite": "8.2.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^5.0.0",
    "babel": "^6.23.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "vitest-browser-vue": "^3.1.0",
    "ws": "^8.21.3"
  }
